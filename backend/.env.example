PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.omhoeyg.mongodb.net/chatbots-ai?retryWrites=true&w=majority"
JWT_SECRET=change-me-to-a-long-random-secret
